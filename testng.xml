<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Warehouse Quality Suite">
  <listeners>
    <listener class-name="com.ganesna.wms.base.AppLifecycleListener"/>
  </listeners>

  <!-- API tests: fast, run first, in order -->
  <test name="API Tests">
    <packages>
      <package name="com.ganesna.wms.tests.api"/>
    </packages>
  </test>

  <!-- UI + cross-layer tests: every thread gets its own browser -->
  <test name="UI and End-to-End Tests" parallel="methods" thread-count="2">
    <packages>
      <package name="com.ganesna.wms.tests.ui"/>
      <package name="com.ganesna.wms.tests.e2e"/>
    </packages>
  </test>
</suite>
